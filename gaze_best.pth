cat > /users/project1/pt01281/gaze_outputs/job_train.sh <<'SH'
#!/bin/bash
#SBATCH -J gaze_train
#SBATCH -p gpu-a100-80gb
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH -t 24:00:00
#SBATCH -o /users/project1/pt01281/gaze_outputs/logs/%x-%j.out

set -euo pipefail

# Activate env
source ~/miniconda3/etc/profile.d/conda.sh
conda activate gaze_a100

export HDF5_USE_FILE_LOCKING=FALSE
export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-8}

DATA_ROOT="/users/project1/pt01281/dataset/xgaze_224"
VAL_FILE="/users/kdm/divjots2002/gazemain/val_subjects.txt"  # keep here if already created
OUTDIR="/users/project1/pt01281/gaze_outputs/checkpoints"

# Validate dataset
if [[ ! -d "$DATA_ROOT/train" ]]; then
  echo "ERROR: $DATA_ROOT/train not found." >&2
  exit 1
fi

# Full overnight run
DRY_RUN=0

VAL_ARGS=""
if [[ -f "$VAL_FILE" ]]; then
  echo "Using val file: $VAL_FILE"
  VAL_ARGS="--val.subjects_file $VAL_FILE"
else
  echo "WARNING: $VAL_FILE not found; training without a val split."
fi

# Extra args based on DRY_RUN
if [[ "$DRY_RUN" -eq 1 ]]; then
  EXTRA_ARGS="--epochs 1 --train.batch_size 64 --max.train.steps 300 --max.val.batches 50 --max.test.batches 50"
else
  EXTRA_ARGS="--epochs 15 --train.batch_size 128"
fi

python -u /users/kdm/divjots2002/gazemain/main.py \
  --data.root_dir "$DATA_ROOT" \
  --train.num_workers 8 \
  --model.backbone resnet50 \
  --lr 1e-3 \
  --weight_decay 1e-4 \
  --outdir "$OUTDIR" \
  --amp \
  $VAL_ARGS \
  $EXTRA_ARGS

echo "Finish: $(date)"
SH

chmod +x /users/project1/pt01281/gaze_outputs/job_train.sh
